{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "ME Client",
  "version": "0.1.67",
  "identifier": "studio.lytsing.me-client",
  "build": {
    "frontendDist": "../frontend-dist",
    "beforeDevCommand": "bun run build-frontend.js",
    "beforeBuildCommand": "bun run build-frontend.js"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [
      {
        "label": "main",
        "title": "ME Client",
        "width": 1440,
        "height": 900,
        "minWidth": 900,
        "minHeight": 600,
        "center": true,
        "resizable": true,
        "fullscreen": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app"],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  }
}
